{
  "name": "saga-mcp",
  "mcpName": "io.github.PortnovAlex80/saga-mcp",
  "version": "3.0.0-alpha.0",
  "description": "Saga5 conveyor engine for LLM agent factories: event-sourced kernel (Temporal idea), declarative workflow graph (n8n idea), content-addressed production desk (saga idea). SQLite-backed MCP server with an operator board.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "saga-mcp": "dist/index.js",
    "saga5-bridge": "dist/bridge.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.ru.md",
    "LICENSE",
    "manifest.json"
  ],
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "lint": "eslint src/",
    "prepublishOnly": "npm run build",
    "test": "tsc && node --test",
    "bridge": "node dist/bridge.js"
  },
  "keywords": [
    "saga5",
    "conveyor",
    "durable-execution",
    "workflow-engine",
    "event-sourcing",
    "mcp",
    "model-context-protocol",
    "llm-agents",
    "sqlite",
    "ai-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PortnovAlex80/saga-mcp.git"
  },
  "homepage": "https://github.com/PortnovAlex80/saga-mcp#readme",
  "bugs": {
    "url": "https://github.com/PortnovAlex80/saga-mcp/issues"
  },
  "author": "PortnovAlex80",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "better-sqlite3": "^12.6.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "eslint": "^10.7.0",
    "typescript": "^5.7.2"
  }
}
