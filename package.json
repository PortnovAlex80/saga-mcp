{
  "name": "saga-mcp",
  "mcpName": "io.github.PortnovAlex80/saga-mcp",
  "version": "2.0.0",
  "description": "Governance platform for parallel LLM coding agents. SQLite-backed, MCP-native, with contract-governed episode lifecycle, CGAD enforcement layer (18 lint rules), product discovery cycle (hypothesis → metric → observation → hit/kill), and 12 role skills.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "saga-mcp": "dist/index.js",
    "saga-checkpoint": "dist/checkpoint-cli.js"
  },
  "files": [
    "dist",
    "skills",
    "tools",
    "tracker-view",
    "docs",
    "GUARDRAILS.md",
    "README.md",
    "README.ru.md",
    "manifest.json",
    "glama.json",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "tracker": "node tracker-view/tracker-view.mjs",
    "docs-graph": "node tracker-view/docs-graph/server.mjs",
    "cgad-lint": "node tools/cgad-spec-lint.mjs",
    "cgad-lint:test": "node --test tools/cgad-spec-lint.test.mjs",
    "build-receipt": "node tools/build-receipt.mjs",
    "build-receipt:test": "node --test tools/build-receipt.test.mjs",
    "adr-closure:validate": "node tools/adr-closure-registry.mjs",
    "adr-closure:test": "node --test tools/adr-closure-registry.test.mjs",
    "verify:manifest": "node tools/verification-manifest.mjs --run",
    "verify:check": "node tools/verification-manifest.mjs --check",
    "legacy:report": "node tools/legacy-freeze.mjs --report",
    "lint": "eslint src/",
    "prepublishOnly": "npm run build",
    "test": "tsc && node tools/run-full-suite.mjs",
    "test:process-modules": "tsc && node tools/run-process-module-tests.mjs all",
    "test:process-modules:a": "tsc && node tools/run-process-module-tests.mjs a",
    "test:process-modules:b": "tsc && node tools/run-process-module-tests.mjs b",
    "test:factory:ratchet": "node --test tests/architecture/factory-only-ratchet.test.mjs",
    "test:architecture": "tsc && node --test \"tests/architecture/*.test.mjs\" && node tests/dispatcher-race/run.mjs && node tests/dispatcher-race/assign-race.mjs && node tests/dispatcher-race/isolation.mjs && node tests/dispatcher-race/review-verdict-race.mjs && node --test tests/infrastructure/sqlite-workplace-graph.test.mjs tests/infrastructure/effective-desk-base.test.mjs tests/infrastructure/managed-source-change-candidate.test.mjs tests/infrastructure/previous-attempt-desk.test.mjs tests/infrastructure/reconciliation-ledger.test.mjs && node --test tests/dispatcher-race/parallel-concurrency.mjs && node --test tests/dispatcher-race/dispatch-loop-overlap.test.mjs && node --test tests/dispatcher-race/orchestrate-global-budget.test.mjs",
    "test:dispatcher-race": "tsc && node tests/dispatcher-race/run.mjs && node tests/dispatcher-race/assign-race.mjs && node tests/dispatcher-race/isolation.mjs && node tests/dispatcher-race/review-verdict-race.mjs && node tests/dispatcher-race/worktree-isolation.mjs && node --test tests/dispatcher-race/parallel-concurrency.mjs && node --test tests/dispatcher-race/dispatch-loop-overlap.test.mjs && node --test tests/dispatcher-race/orchestrate-global-budget.test.mjs",
    "test:factory-contract": "tsc && node --test \"tests/factory-contract/*.test.mjs\"",
    "test:golden-path": "tsc && node --test tests/factory-contract/golden-path.test.mjs",
    "test:factory-temporal": "tsc && node --test --test-concurrency=1 \"tests/factory-temporal/*.test.mjs\"",
    "test:factory-model": "tsc && node --test \"tests/factory-model/*.test.mjs\"",
    "test:acceptance-matrix": "tsc && node tools/run-acceptance-matrix.mjs",
    "test:acceptance-matrix:list": "node tools/run-acceptance-matrix.mjs --list",
    "workshop:inventory": "node tests/factory-proof/workshop-inventory.mjs --json",
    "workshop:inventory:check": "node tests/factory-proof/workshop-inventory.mjs --check",
    "workshop:inventory:baseline": "node tests/factory-proof/workshop-inventory.mjs --baseline",
    "coverage:factory": "node tests/factory-proof/factory-coverage-universe.mjs",
    "conformance:v1": "node tests/factory-proof/conformance-engine.mjs",
    "conformance:harvest": "node tests/factory-proof/conformance-engine.mjs --harvest",
    "validate:ek-admission-specs": "node tools/validate-ek-admission-specs.mjs",
    "validate:deletion-manifests": "node docs/refactoring/event-kernel/tools/validate-deletion-manifests.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agent-governance",
    "cgad",
    "parallel-agents",
    "contract-driven-development",
    "episode-lifecycle",
    "llm-tools",
    "sqlite",
    "ai-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PortnovAlex80/saga-mcp.git"
  },
  "homepage": "https://github.com/PortnovAlex80/saga-mcp#readme",
  "bugs": {
    "url": "https://github.com/PortnovAlex80/saga-mcp/issues"
  },
  "author": "PortnovAlex80",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "better-sqlite3": "^12.6.0",
    "dejavu-fonts-ttf": "2.37.3",
    "pdfkit": "0.17.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "eslint": "^10.7.0",
    "typescript": "^5.7.2"
  }
}
