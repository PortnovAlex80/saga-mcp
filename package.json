{
  "name": "saga-mcp",
  "mcpName": "io.github.PortnovAlex80/saga-mcp",
  "version": "2.0.0",
  "description": "Governance platform for parallel LLM coding agents. SQLite-backed, MCP-native, with contract-governed episode lifecycle, CGAD enforcement layer (18 lint rules), product discovery cycle (hypothesis → metric → observation → hit/kill), and 12 role skills.",
  "type": "module",
  "main": "dist/workflow-kernel/composition/index.js",
  "bin": {
    "saga-mcp": "dist/workflow-kernel/composition/entry.js"
  },
  "files": [
    "dist",
    "skills",
    "tools",
    "docs",
    "GUARDRAILS.md",
    "README.md",
    "README.ru.md",
    "manifest.json",
    "glama.json",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc && node tools/copy-installed-mjs.mjs",
    "watch": "tsc --watch",
    "start": "node dist/workflow-kernel/composition/entry.js",
    "dev": "tsc && node dist/workflow-kernel/composition/entry.js",
    "cgad-lint": "node tools/cgad-spec-lint.mjs",
    "cgad-lint:test": "node --test tools/cgad-spec-lint.test.mjs",
    "build-receipt": "node tools/build-receipt.mjs",
    "build-receipt:test": "node --test tools/build-receipt.test.mjs",
    "adr-closure:validate": "node tools/adr-closure-registry.mjs",
    "adr-closure:test": "node --test tools/adr-closure-registry.test.mjs",
    "verify:manifest": "node tools/verification-manifest.mjs --run",
    "verify:check": "node tools/verification-manifest.mjs --check",
    "legacy:report": "node tools/legacy-freeze.mjs --report",
    "lint": "eslint src/",
    "prepublishOnly": "npm run build",
    "test": "tsc && node tools/run-acceptance-matrix.mjs",
    "test:architecture": "tsc && node tools/run-acceptance-matrix.mjs --group architecture",
    "test:acceptance-matrix": "tsc && node tools/run-acceptance-matrix.mjs",
    "test:acceptance-matrix:list": "node tools/run-acceptance-matrix.mjs --list",
    "validate:ek-admission-specs": "node tools/validate-ek-admission-specs.mjs",
    "validate:deletion-manifests": "node docs/refactoring/event-kernel/tools/validate-deletion-manifests.mjs",
    "test:workflow-model": "node --test \"tests/workflow-kernel/model/*.test.mjs\"",
    "test:workflow-persistence": "tsc && node --test \"tests/workflow-kernel/persistence/*.test.mjs\"",
    "test:workflow-complexity": "node dist/workflow-kernel/domain/complexity-check.js",
    "test:legacy-zero": "node tools/ek-legacy-zero.mjs --strict",
    "corpus:full": "node tools/project-corpus/run-corpus.mjs --full",
    "corpus:smoke": "node tools/project-corpus/run-corpus.mjs --smoke",
    "corpus:kit-replay": "node tools/project-corpus/replay-elite-kit.mjs",
    "qualify:kit": "node tools/qualify/kit.mjs",
    "qualify:development": "node tools/qualify/development-series.mjs",
    "qualify:projects:scripted": "node tools/qualify/projects-scripted.mjs",
    "qualify:concurrency": "node tools/qualify/concurrency.mjs",
    "qualify:projects:real": "node tools/qualify/real-series.mjs",
    "qualify:proof": "node --test tests/qualify/kit-fences.proof.mjs tests/qualify/kinds-map.proof.mjs tests/qualify/product-evidence.proof.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agent-governance",
    "cgad",
    "parallel-agents",
    "contract-driven-development",
    "episode-lifecycle",
    "llm-tools",
    "sqlite",
    "ai-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PortnovAlex80/saga-mcp.git"
  },
  "homepage": "https://github.com/PortnovAlex80/saga-mcp#readme",
  "bugs": {
    "url": "https://github.com/PortnovAlex80/saga-mcp/issues"
  },
  "author": "PortnovAlex80",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "better-sqlite3": "^12.6.0",
    "dejavu-fonts-ttf": "2.37.3",
    "pdfkit": "0.17.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "eslint": "^10.7.0",
    "typescript": "^5.7.2"
  }
}
