{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true
  },
  // FRF-WP11 cutover: the cells and the WP03 contracts are INSTALLED
// package surfaces (tsc compiles the .ts cells; tools/copy-installed-mjs.mjs
// mirrors the .mjs cells, the contracts tree and the Development handoff
// desks into dist as the build's second step - the pre-cutover exclusion
// of the acceptance cell died with its TEST-ONLY fence).
  "include": ["src/**/*"]
}
