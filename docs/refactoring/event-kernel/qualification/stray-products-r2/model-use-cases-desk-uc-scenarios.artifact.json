        "schemaVersion": "frf-contracts.uc-scenario-member.v1",
        "scenarioId": "uc:terminal-1",
        "actorKind": "operator",
        "actorIdentity": "message service operator performing terminal triage",
        "goal": "Close the run terminal state with the audited go triage and recorded strengths (terminal:audited-1).",
        "trigger": "The delivered outcome and its audit record are complete for terminal triage.",
        "preconditions": [
          "The accepted outcome has been delivered (uc:outcome-1 main terminal branch)."
        ],
        "operationalSteps": [
