      {
        "schemaVersion": "frf-contracts.uc-scenario-member.v1",
        "scenarioId": "uc:boundary-1",
        "actorKind": "human",
        "actorIdentity": "message service user with a service account",
        "goal": "Exchange a message with the message service and receive its response inside the accepted system boundary (claim:scope-1).",
        "trigger": "The user submits a message to the message service.",
        "preconditions": [
          "The message service is available within the scope of accepted Discovery source claim 1 (claim:scope-1)."
        ],
        "operationalSteps": [
          "The user submits a message to the message service.",
          "The service processes the submitted message.",
          "The service returns its deterministic response to the user.",
          "The completed interaction stays inside the accepted system boundary of the message service."
        ],
        "alternateFlows": [],
        "errorFlows": [],
        "terminalBranches": [
          {
            "branchId": "branch:boundary-1-main",
            "branchKind": "main",
            "terminalResult": "The user receives the service response and the interaction closed inside the accepted system boundary."
          }
        ],
        "postcondition": "The request-response interaction completed inside the accepted message service boundary.",
        "prdIntentRefs": [
          "prd:boundary-1"
        ],
        "evidenceKindRefs": [
          "test"
        ]
      },
      {
        "schemaVersion": "frf-contracts.uc-scenario-member.v1",
        "scenarioId": "uc:outcome-1",
        "actorKind": "human",
        "actorIdentity": "message service user with a service account",
        "goal": "Obtain the accepted Discovery outcome (claim:outcome-1) delivered by the message service, closing terminal lifecycle claim terminal:delivered-1.",
        "trigger": "The user submits a message requesting the service outcome.",
        "preconditions": [
          "The message service is operating inside the accepted scope boundary (claim:scope-1)."
        ],
        "operationalSteps": [
          "The user submits a message requesting the outcome.",
          "The service processes the message and produces its deterministic response.",
          "The service delivers the response to the user.",
          "The delivery of the accepted outcome is recorded."
        ],
        "alternateFlows": [],
        "errorFlows": [
          {
            "branchId": "branch:outcome-1-deterministic-error",
            "steps": [
              "The service cannot produce a response for the submitted message.",
              "The service returns a deterministic error response and invents no nondeterministic content (constraint:retention-1)."
            ]
          }
        ],
        "terminalBranches": [
          {
            "branchId": "branch:outcome-1-main",
            "branchKind": "main",
            "terminalResult": "The accepted Discovery outcome is delivered to the user (terminal:delivered-1)."
          },
          {
            "branchId": "branch:outcome-1-deterministic-error",
            "branchKind": "error",
            "terminalResult": "The user receives a deterministic error response; no nondeterministic content is produced."
          }
        ],
        "postcondition": "The accepted Discovery outcome is delivered and observable by the user (terminal:delivered-1).",
        "prdIntentRefs": [
          "prd:outcome-1"
        ],
        "evidenceKindRefs": [
          "monitoring",
          "test"
        ]
      },
