          "claim:scope-2"
        ],
        "disposition": {
          "disposition": "out_of_scope",
          "owner": "product-owner",
          "reason": "Explicit disposition of accepted Discovery scope claim 2 at intent freeze; excluded from this release by the Discovery decision recorded in the capsule."
        }
      },
      {
        "schemaVersion": "frf-contracts.prd-intent-member.v1",
        "memberId": "prd:constraint-1",
        "memberKind": "constraint",
        "statement": "Deterministic responses only; no nondeterministic content.",
        "sourceClaimRefs": [
          "claim:constraint-1"
        ],
        "disposition": {
          "disposition": "direct_requirement",
          "reason": "An operational determinism constraint binding every response and every downstream artifact; it has no meaningful interaction or operational scenario of its own."
        }
      },
      {
        "schemaVersion": "frf-contracts.prd-intent-member.v1",
