      {
        "schemaVersion": "frf-contracts.prd-intent-member.v1",
        "memberId": "prd:boundary-1",
        "memberKind": "system-boundary",
        "statement": "The subject of this intent is the message service exactly as scoped by accepted Discovery source claim 1; the desk adds no scope beyond the accepted Discovery capsule.",
